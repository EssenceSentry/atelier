[%- set initials = (project_name.split() | map('first') | join)[:2] | upper -%]
[%- set accent = {'instrument': '#3665e4', 'editorial': '#b04a24', 'console': '#7552db'}[theme] -%]
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
  <title>[[ project_name | e ]]</title>
  <!-- Placeholder: replace with the same mark as src/app-icon.tsx. -->
  <rect width="32" height="32" rx="8" fill="[[ accent ]]"/>
  <text x="16" y="21.5" text-anchor="middle" font-size="13" font-weight="700" fill="#ffffff" font-family="system-ui, sans-serif">[[ initials ]]</text>
</svg>
