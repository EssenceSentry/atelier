{
  "name": "atelier",
  "private": true,
  "description": "Opinionated starter kit and project generator for agent-built dashboards, review tools, labs and reports.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gallery": "npm run dev:board --workspace @atelier/gallery",
    "playground": "npm run dev:playground --workspace @atelier/gallery",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "capture": "npm run capture --workspace @atelier/gallery",
    "lint": "biome check",
    "fix": "biome check --write",
    "try-template": "node scripts/try-template.mjs"
  },
  "overrides": {
    "@ts-morph/common@0.27.0": {
      "minimatch": "^11.0.1"
    },
    "@linaria/react": {
      "minimatch": "^11.0.9"
    },
    "@wyw-in-js/shared": {
      "minimatch": "^11.0.9"
    },
    "@tensorflow/tfjs-vis": {
      "vega": "^6.4.0",
      "vega-lite": "^6.5.0"
    },
    "compassql": {
      "vega-lite": "^6.5.0",
      "datalib": {
        "request": "npm:@cypress/request@^4.0.1"
      }
    },
    "typescript-json-schema@0.9.2": {
      "yargs": "^17.7.2"
    },
    "isomorphic-fetch": {
      "node-fetch": "^2.7.0"
    },
    "markdown-it": "^14.3.3",
    "csv-parse": "^7.0.3",
    "rehype-katex": {
      "katex": "^0.19.1"
    },
    "micromark-extension-math": {
      "katex": "^0.19.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "shadcn": "^4.22.1"
  }
}
