  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:board": "THEME=all vite",
    "dev:playground": "THEME=all vite --host 127.0.0.1 --port 5189 --strictPort --open /playground.html",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "capture": "node scripts/capture.mjs http://localhost:5188 captures",
    "check:playground": "node scripts/check-playground.mjs",
    "capture:playground": "node scripts/check-playground.mjs http://127.0.0.1:5189 --matrix",
    "build:artifact": "THEME=all ATELIER_TARGET=artifact vite build --outDir dist/artifact"
