{
  "name": "@atelier/gallery",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:board": "THEME=all vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "capture": "node scripts/capture.mjs http://localhost:5188 captures",
    "build:artifact": "THEME=all ATELIER_TARGET=artifact vite build --outDir dist/artifact"
  },
  "dependencies": {
    "@atelier/theme": "*",
    "@base-ui/react": "^1.9.0",
    "@observablehq/plot": "^0.6.17",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "playwright": "1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8"
  },
  "description": "Every block and screen in every direction; the visual check for the kit."
}
